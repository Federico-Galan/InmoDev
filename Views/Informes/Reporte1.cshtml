@model IEnumerable<Inmueble>
@{
    ViewData["Title"] = "Reporte 1: Inmuebles y Propietarios";
    bool? disponible = ViewBag.Disponible;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Informes</a></li>
                <li class="breadcrumb-item active">Reporte 1</li>
            </ol>
        </nav>
        <h1 class="h3 mb-0 text-dark"><i class="fa-solid fa-building-user me-2 text-primary"></i>Inmuebles y sus Respectivos Dueños</h1>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i> Volver a Informes
    </a>
</div>

<!-- Filtros Server-Side -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="disponible" class="form-label fw-semibold">Filtrar por Disponibilidad:</label>
                <select name="disponible" id="disponible" class="form-select">
                    <option value="" selected="@(disponible == null)">-- Todos los estados --</option>
                    <option value="true" selected="@(disponible == true)">Solo Disponibles para Alquiler</option>
                    <option value="false" selected="@(disponible == false)">Solo No Disponibles / Suspendidos</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-filter me-1"></i> Filtrar
                </button>
                <a asp-action="Reporte1" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-rotate-left me-1"></i> Limpiar
                </a>
            </div>
            <div class="col-md-4 text-md-end text-muted small">
                Total encontrados: <span class="fw-bold text-dark">@Model.Count()</span> inmuebles
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Inmueble</th>
                    <th>Tipo</th>
                    <th>Propietario / Dueño</th>
                    <th>Contacto</th>
                    <th>Tarifa Diaria</th>
                    <th>Cupo</th>
                    <th>Disponibilidad</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="fa-regular fa-folder-open fs-3 d-block mb-2"></i>
                            No se encontraron inmuebles con el filtro seleccionado.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.Direccion</div>
                            <small class="text-muted">Cód. #@item.Id</small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@item.TipoNombre</span>
                        </td>
                        <td>
                            <div class="fw-semibold text-primary">@item.PropietarioNombre</div>
                            <small class="text-muted">ID Propietario: #@item.PropietarioId</small>
                        </td>
                        <td>
                            <div><i class="fa-solid fa-phone small me-1 text-muted"></i>@(string.IsNullOrWhiteSpace(item.PropietarioTelefono) ? "Sin registrar" : item.PropietarioTelefono)</div>
                            <small class="text-muted"><i class="fa-solid fa-envelope small me-1"></i>@(string.IsNullOrWhiteSpace(item.PropietarioEmail) ? "Sin email" : item.PropietarioEmail)</small>
                        </td>
                        <td>
                            <div class="fw-bold">@item.MonedaPrecio @item.PrecioPorDia.ToString("N2")</div>
                            <small class="text-muted">Seña: @item.PorcentajeReserva%</small>
                        </td>
                        <td>
                            @(item.CupoMaximo.HasValue ? $"{item.CupoMaximo} personas" : "Sin cupo")
                        </td>
                        <td>
                            @if (item.Disponible)
                            {
                                <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Disponible</span>
                            }
                            else
                            {
                                <span class="badge bg-danger"><i class="fa-solid fa-ban me-1"></i>Suspendido</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Inmuebles" asp-action="Details" asp-route-id="@item.Id" title="Ver ficha del inmueble">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
