@model IEnumerable<InmuebleRanking>
@{
    ViewData["Title"] = "Reporte 3: Ranking de Inmuebles Más Reservados";
    int posicion = 1;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Informes</a></li>
                <li class="breadcrumb-item active">Reporte 3</li>
            </ol>
        </nav>
        <h1 class="h3 mb-0 text-dark"><i class="fa-solid fa-ranking-star me-2 text-warning"></i>Ranking de Inmuebles Más Reservados</h1>
        <p class="text-muted mb-0">Rendimiento contractual acumulado en los últimos 365 días corridos.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i> Volver a Informes
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-center" style="width: 70px;">Puesto</th>
                    <th>Inmueble</th>
                    <th>Tipo</th>
                    <th>Dueño</th>
                    <th class="text-center">Cant. Reservas</th>
                    <th class="text-center">Días Ocupados</th>
                    <th class="text-end">Recaudación Estimada</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="fa-regular fa-folder-open fs-3 d-block mb-2"></i>
                            No se registran reservas en los últimos 365 días.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center">
                            @if (posicion == 1)
                            {
                                <span class="badge bg-warning text-dark fs-6 rounded-pill px-3 shadow-sm">
                                    <i class="fa-solid fa-crown me-1"></i>1°
                                </span>
                            }
                            else if (posicion == 2)
                            {
                                <span class="badge bg-secondary text-white fs-6 rounded-pill px-3 shadow-sm">2°</span>
                            }
                            else if (posicion == 3)
                            {
                                <span class="badge bg-danger text-white fs-6 rounded-pill px-3 shadow-sm">3°</span>
                            }
                            else
                            {
                                <span class="text-muted fw-bold">@(posicion)°</span>
                            }
                        </td>
                        <td>
                            <div class="fw-semibold">@item.Direccion</div>
                            <small class="text-muted">Cód. #@item.Id</small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@item.TipoNombre</span>
                        </td>
                        <td>
                            <div class="fw-medium text-dark">@item.PropietarioNombre</div>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-primary fs-6 px-3">@item.CantidadReservas</span>
                        </td>
                        <td class="text-center">
                            <span class="fw-bold text-dark">@item.TotalDiasReservados</span> <span class="small text-muted">días</span>
                        </td>
                        <td class="text-end">
                            <span class="fw-bold text-success">@item.MonedaPrecio @item.TotalRecaudado.ToString("N2")</span>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Inmuebles" asp-action="Details" asp-route-id="@item.Id" title="Ver inmueble">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                    posicion++;
                }
            </tbody>
        </table>
    </div>
</div>
