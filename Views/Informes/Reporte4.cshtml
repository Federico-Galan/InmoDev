@model IEnumerable<Inmueble>
@{
    ViewData["Title"] = "Reporte 4: Inmuebles Sin Reservas Recientes";
    int dias = ViewBag.Dias ?? 30;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Informes</a></li>
                <li class="breadcrumb-item active">Reporte 4</li>
            </ol>
        </nav>
        <h1 class="h3 mb-0 text-dark"><i class="fa-solid fa-bed me-2 text-secondary"></i>Inmuebles Sin Reservas en los Últimos Días</h1>
        <p class="text-muted mb-0">Identifique inmuebles sin movimiento contractual para revisar precios o condiciones comerciales.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i> Volver a Informes
    </a>
</div>

<!-- Selector de Plazo (Server-Side) -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5 col-lg-4">
                <label for="dias" class="form-label fw-semibold">Plazo sin actividad contractual:</label>
                <select name="dias" id="dias" class="form-select" onchange="this.form.submit()">
                    <option value="30" selected="@(dias == 30)">Últimos 30 días (1 mes)</option>
                    <option value="60" selected="@(dias == 60)">Últimos 60 días (2 meses)</option>
                    <option value="90" selected="@(dias == 90)">Últimos 90 días (3 meses)</option>
                    <option value="180" selected="@(dias == 180)">Últimos 180 días (6 meses)</option>
                    <option value="365" selected="@(dias == 365)">Últimos 365 días (1 año)</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-secondary">
                    <i class="fa-solid fa-filter me-1"></i> Aplicar
                </button>
            </div>
            <div class="col-md-3 text-md-end text-muted small">
                Inmuebles inactivos: <span class="fw-bold text-danger">@Model.Count()</span>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Inmueble</th>
                    <th>Tipo</th>
                    <th>Dueño</th>
                    <th>Contacto Propietario</th>
                    <th>Tarifa Diaria</th>
                    <th>Estado de Oferta</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="fa-solid fa-check-double fs-3 d-block text-success mb-2"></i>
                            ¡Excelente! Todos los inmuebles registran reservas dentro de los últimos @dias días.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.Direccion</div>
                            <small class="text-muted">Cód. #@item.Id</small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@item.TipoNombre</span>
                        </td>
                        <td>
                            <div class="fw-medium">@item.PropietarioNombre</div>
                        </td>
                        <td>
                            <div><i class="fa-solid fa-phone small me-1 text-muted"></i>@(string.IsNullOrWhiteSpace(item.PropietarioTelefono) ? "Sin registrar" : item.PropietarioTelefono)</div>
                            <small class="text-muted"><i class="fa-solid fa-envelope small me-1"></i>@(string.IsNullOrWhiteSpace(item.PropietarioEmail) ? "Sin email" : item.PropietarioEmail)</small>
                        </td>
                        <td>
                            <span class="fw-bold">@item.MonedaPrecio @item.PrecioPorDia.ToString("N2")</span>
                        </td>
                        <td>
                            @if (item.Disponible)
                            {
                                <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Disponible</span>
                            }
                            else
                            {
                                <span class="badge bg-danger"><i class="fa-solid fa-ban me-1"></i>Suspendido</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group" role="group">
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Inmuebles" asp-action="Details" asp-route-id="@item.Id" title="Ver inmueble">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a class="btn btn-sm btn-outline-success" asp-controller="Reservas" asp-action="Create" asp-route-inmuebleId="@item.Id" title="Crear reserva">
                                    <i class="fa-solid fa-calendar-plus"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
