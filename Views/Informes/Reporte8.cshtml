@model IEnumerable<Inmueble>
@{
    ViewData["Title"] = "Reporte 8: Consulta de Disponibilidad";
    string fechaInicio = ViewBag.FechaInicio ?? DateTime.Today.ToString("yyyy-MM-dd");
    string fechaFin = ViewBag.FechaFin ?? DateTime.Today.AddDays(7).ToString("yyyy-MM-dd");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Informes</a></li>
                <li class="breadcrumb-item active">Reporte 8</li>
            </ol>
        </nav>
        <h1 class="h3 mb-0 text-dark"><i class="fa-solid fa-magnifying-glass-location me-2 text-primary"></i>Consulta de Inmuebles Disponibles</h1>
        <p class="text-muted mb-0">Indique un intervalo de fechas para listar los inmuebles desocupados y listos para alquilar.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i> Volver a Informes
    </a>
</div>

<!-- Filtros de Fechas -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label for="fechaInicio" class="form-label fw-semibold">Fecha de Entrada:</label>
                <input type="date" name="fechaInicio" id="fechaInicio" class="form-control" value="@fechaInicio" required />
            </div>
            <div class="col-md-3">
                <label for="fechaFin" class="form-label fw-semibold">Fecha de Salida:</label>
                <input type="date" name="fechaFin" id="fechaFin" class="form-control" value="@fechaFin" required />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-magnifying-glass me-1"></i> Consultar Disponibilidad
                </button>
            </div>
            <div class="col-md-3 text-md-end text-muted small">
                Inmuebles libres: <span class="fw-bold text-success">@Model.Count()</span>
            </div>
        </form>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger shadow-sm">
        <div asp-validation-summary="All" class="mb-0"></div>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Inmueble</th>
                    <th>Tipo</th>
                    <th>Dueño</th>
                    <th>Tarifa por Día</th>
                    <th>Cupo Máximo</th>
                    <th>Seña Requerida</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="fa-solid fa-calendar-xmark fs-3 d-block mb-2 text-warning"></i>
                            No hay inmuebles disponibles para el rango de fechas consultado.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.Direccion</div>
                            <small class="text-muted">Cód. #@item.Id</small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@item.TipoNombre</span>
                        </td>
                        <td>
                            <div class="fw-medium">@item.PropietarioNombre</div>
                            <small class="text-muted"><i class="fa-solid fa-phone me-1"></i>@(string.IsNullOrWhiteSpace(item.PropietarioTelefono) ? "S/D" : item.PropietarioTelefono)</small>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@item.MonedaPrecio @item.PrecioPorDia.ToString("N2")</div>
                        </td>
                        <td>
                            @(item.CupoMaximo.HasValue ? $"{item.CupoMaximo} personas" : "Sin límite")
                        </td>
                        <td>
                            @item.PorcentajeReserva%
                        </td>
                        <td class="text-end">
                            <div class="btn-group" role="group">
                                <a class="btn btn-sm btn-success fw-semibold"
                                   asp-controller="Reservas"
                                   asp-action="Create"
                                   asp-route-inmuebleId="@item.Id"
                                   asp-route-fechaInicio="@fechaInicio"
                                   asp-route-fechaFin="@fechaFin"
                                   title="Iniciar reserva directa">
                                    <i class="fa-solid fa-calendar-plus me-1"></i> Reservar
                                </a>
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Inmuebles" asp-action="Details" asp-route-id="@item.Id" title="Ver inmueble">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
