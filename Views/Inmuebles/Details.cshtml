@model Inmueble

@{
    ViewData["Title"] = "Detalle inmueble";
}

<h1 class="h3">Detalle inmueble</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Direccion)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Direccion)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PropietarioNombre)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.PropietarioNombre)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TipoNombre)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.TipoNombre)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CupoMaximo)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.CupoMaximo)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Coordenadas)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Coordenadas)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PrecioPorDia)</dt>
    <dd class="col-sm-9">@Model.MonedaPrecio @Model.PrecioPorDia.ToString("N2")</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ImagenPortada)</dt>
    <dd class="col-sm-9">
        @if (!string.IsNullOrWhiteSpace(Model.ImagenPortada))
        {
            <img src="@Model.ImagenPortada" alt="Portada del inmueble" class="img-thumbnail inmueble-portada-detalle" />
        }
        else
        {
            <span>Sin portada</span>
        }
    </dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Disponible)</dt>
    <dd class="col-sm-9">@(Model.Disponible ? "Si" : "No")</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FechaRegistro)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.FechaRegistro)</dd>
</dl>

<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
<a class="btn btn-success" asp-action="Fotos" asp-route-id="@Model.Id">Fotos</a>
<a class="btn btn-secondary" asp-action="Index">Volver</a>
