@model Inquilino

@{
    ViewData["Title"] = "Eliminar inquilino";
}

<h1 class="h3">Eliminar inquilino</h1>
<hr />

<p>Seguro que desea eliminar el inquilino <strong>@Model.NombreCompleto</strong>?</p>

<form asp-action="Delete" asp-route-id="@Model.Id">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</form>
