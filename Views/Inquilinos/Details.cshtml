@model Inquilino

@{
    ViewData["Title"] = "Detalle inquilino";
}

<h1 class="h3">Detalle inquilino</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DNI)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.DNI)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NombreCompleto)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.NombreCompleto)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Telefono)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Telefono)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Direccion)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Direccion)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FechaRegistro)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.FechaRegistro)</dd>
</dl>

<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
<a class="btn btn-secondary" asp-action="Index">Volver</a>
