@model IEnumerable<Pago>
@{
    var reserva = ViewBag.Reserva as Reserva;
    ViewData["Title"] = "Pagos de Reserva #" + (reserva?.Id ?? 0);
    var totalPagado = Model.Where(p => p.Estado != "Anulado").Sum(p => p.Importe);
    var saldo = reserva != null ? Math.Max(0, (reserva.MontoTotalEstimado + (reserva.MultaAplicada ?? 0)) - totalPagado) : 0;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Pagos de Reserva #@reserva?.Id</h1>
        <p class="text-muted small mb-0">
            <strong>Inmueble:</strong> @reserva?.InmuebleDireccion | <strong>Inquilino:</strong> @reserva?.InquilinoNombre
        </p>
    </div>
    <div class="btn-group">
        <a class="btn btn-secondary" asp-controller="Reservas" asp-action="Details" asp-route-id="@reserva?.Id">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver a Reserva
        </a>
        <a class="btn btn-primary" asp-action="Create" asp-route-reservaId="@reserva?.Id">
            <i class="fa-solid fa-money-bill-transfer me-1"></i> Cargar Nuevo Pago
        </a>
    </div>
</div>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-info">@ViewBag.Mensaje</div>
}

<!-- Panel de Balance de la Reserva -->
<div class="card shadow-sm border-0 mb-4 bg-light">
    <div class="card-body p-3">
        <div class="row text-center">
            <div class="col-md-3">
                <div class="text-muted small">Costo Total Contratado</div>
                <div class="h5 fw-bold mb-0">@reserva?.MonedaPrecio @reserva?.MontoTotalEstimado.ToString("N2")</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Seña Requerida (@reserva?.PorcentajeSena?.ToString("N0")%)</div>
                <div class="h5 fw-bold text-info mb-0">@reserva?.MonedaPrecio @reserva?.MontoSenaRequerido.ToString("N2")</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Total Pagado Activo</div>
                <div class="h5 fw-bold text-success mb-0">@reserva?.MonedaPrecio @totalPagado.ToString("N2")</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Saldo Restante</div>
                <div class="h5 fw-bold @(saldo > 0 ? "text-danger" : "text-success") mb-0">
                    @reserva?.MonedaPrecio @saldo.ToString("N2")
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0"><i class="fa-solid fa-receipt me-2 text-primary"></i>Movimientos Registrados</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>N° Pago</th>
                        <th>Fecha de Pago</th>
                        <th>Concepto</th>
                        <th>Importe</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Aún no se han registrado pagos para esta reserva.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.Estado == "Anulado" ? "table-light text-muted opacity-75" : "")">
                            <td class="fw-bold">#@item.Id</td>
                            <td>@item.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.Concepto</td>
                            <td>
                                <span class="fw-bold @(item.Estado == "Anulado" ? "text-decoration-line-through text-danger" : "text-success")">
                                    @item.MonedaPrecio @item.Importe.ToString("N2")
                                </span>
                            </td>
                            <td>
                                @if (item.Estado == "Activo")
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Anulado</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id" title="Detalle">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    @if (item.Estado == "Activo")
                                    {
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id" title="Editar Concepto">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <form asp-action="Anular" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('¿Confirma la anulación de este pago?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Anular Pago (Baja lógica)">
                                                    <i class="fa-solid fa-ban"></i>
                                                </button>
                                            </form>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
