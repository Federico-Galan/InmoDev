@model Reserva
@{
    ViewData["Title"] = "Nueva Reserva";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h1 class="h4 mb-0"><i class="fa-solid fa-calendar-plus text-primary me-2"></i>Nueva Reserva de Alquiler</h1>
                <a class="btn btn-sm btn-outline-info" asp-action="BuscarDisponibles"><i class="fa-solid fa-search me-1"></i> Consultar Disponibilidad</a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="formReserva">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="InquilinoId" class="form-label fw-semibold"></label>
                            <select asp-for="InquilinoId" class="form-select" asp-items="ViewBag.Inquilinos">
                                <option value="0">-- Seleccione un inquilino --</option>
                            </select>
                            <span asp-validation-for="InquilinoId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="InmuebleId" class="form-label fw-semibold"></label>
                            <select asp-for="InmuebleId" class="form-select" asp-items="ViewBag.Inmuebles" id="selectInmueble">
                                <option value="0">-- Seleccione un inmueble --</option>
                            </select>
                            <span asp-validation-for="InmuebleId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FechaInicio" class="form-label fw-semibold"></label>
                            <input asp-for="FechaInicio" type="date" class="form-control" id="inputInicio" />
                            <span asp-validation-for="FechaInicio" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="FechaFin" class="form-label fw-semibold"></label>
                            <input asp-for="FechaFin" type="date" class="form-control" id="inputFin" />
                            <span asp-validation-for="FechaFin" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MontoPorDia" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="MontoPorDia" class="form-control" step="0.01" min="0.01" id="inputMontoDia" />
                            </div>
                            <span asp-validation-for="MontoPorDia" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="PorcentajeSena" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="PorcentajeSena" class="form-control" min="0" max="100" step="1" id="inputPorcentajeSena" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="PorcentajeSena" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Resumen dinámico de cálculo -->
                    <div class="card bg-light border-0 my-3">
                        <div class="card-body">
                            <h6 class="fw-bold mb-2"><i class="fa-solid fa-calculator me-1"></i> Resumen de la Operación</h6>
                            <div class="row text-center">
                                <div class="col-4">
                                    <div class="text-muted small">Días</div>
                                    <div class="h5 fw-bold mb-0" id="resumenDias">-</div>
                                </div>
                                <div class="col-4">
                                    <div class="text-muted small">Total Estimado</div>
                                    <div class="h5 fw-bold text-primary mb-0" id="resumenTotal">$0.00</div>
                                </div>
                                <div class="col-4">
                                    <div class="text-muted small">Seña a Abonar</div>
                                    <div class="h5 fw-bold text-success mb-0" id="resumenSena">$0.00</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
                        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i> Confirmar Reserva</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function calcularResumen() {
            const inicio = new Date($('#inputInicio').val());
            const fin = new Date($('#inputFin').val());
            const montoDia = parseFloat($('#inputMontoDia').val()) || 0;
            const pctSena = parseFloat($('#inputPorcentajeSena').val()) || 0;

            if (inicio && fin && fin >= inicio) {
                const diffTime = Math.abs(fin - inicio);
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
                const total = diffDays * montoDia;
                const sena = total * (pctSena / 100);

                $('#resumenDias').text(diffDays);
                $('#resumenTotal').text('$' + total.toLocaleString('es-AR', { minimumFractionDigits: 2 }));
                $('#resumenSena').text('$' + sena.toLocaleString('es-AR', { minimumFractionDigits: 2 }));
            } else {
                $('#resumenDias').text('-');
                $('#resumenTotal').text('$0.00');
                $('#resumenSena').text('$0.00');
            }
        }

        $('#inputInicio, #inputFin, #inputMontoDia, #inputPorcentajeSena').on('input change', calcularResumen);

        $('#selectInmueble').on('change', function() {
            const id = $(this).val();
            if (id > 0) {
                $.getJSON('/Reservas/ObtenerInfoInmueble/' + id, function(data) {
                    if (data) {
                        $('#inputMontoDia').val(data.precio);
                        $('#inputPorcentajeSena').val(data.porcentaje);
                        calcularResumen();
                    }
                });
            }
        });

        $(document).ready(function() {
            calcularResumen();
        });
    </script>
}
