@model Reserva
@{
    ViewData["Title"] = "Eliminar Reserva";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h1 class="h4 mb-0"><i class="fa-solid fa-trash-can me-2"></i>Eliminar Reserva #@Model.Id</h1>
            </div>
            <div class="card-body p-4">
                <p class="lead text-center">¿Está seguro de que desea eliminar permanentemente esta reserva?</p>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Inmueble:</dt>
                    <dd class="col-sm-8">@Model.InmuebleDireccion</dd>
                    <dt class="col-sm-4">Inquilino:</dt>
                    <dd class="col-sm-8">@Model.InquilinoNombre</dd>
                    <dt class="col-sm-4">Fechas:</dt>
                    <dd class="col-sm-8">@Model.FechaInicio.ToString("dd/MM/yyyy") al @Model.FechaFin.ToString("dd/MM/yyyy")</dd>
                    <dt class="col-sm-4">Total Pagado:</dt>
                    <dd class="col-sm-8">@Model.MonedaPrecio @Model.TotalPagado.ToString("N2")</dd>
                </dl>
            </div>
            <div class="card-footer bg-white d-flex justify-content-between">
                <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash me-1"></i> Confirmar Eliminación</button>
                </form>
            </div>
        </div>
    </div>
</div>
