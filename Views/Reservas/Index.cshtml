@model IEnumerable<Reserva>
@{
    ViewData["Title"] = "Reservas";
    var pagina = ViewBag.Pagina as int? ?? 1;
    var totalPaginas = ViewBag.TotalPaginas as int? ?? 1;
    var estado = ViewBag.Estado as string;
    var desde = ViewBag.Desde as string;
    var hasta = ViewBag.Hasta as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Reservas de Alquiler</h1>
        <p class="text-muted small mb-0">Gestión de alquileres temporarios y contratos</p>
    </div>
    <div class="btn-group">
        <a class="btn btn-outline-primary" asp-action="BuscarDisponibles"><i class="fa-solid fa-calendar-check me-1"></i> Buscar Disponibles</a>
        <a class="btn btn-primary" asp-action="Create"><i class="fa-solid fa-plus me-1"></i> Nueva Reserva</a>
    </div>
</div>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-info">@ViewBag.Mensaje</div>
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Estado</label>
                <select name="estado" class="form-select form-select-sm">
                    <option value="">-- Todos los estados --</option>
                    <option value="Vigente" selected="@(estado == "Vigente")">Vigente</option>
                    <option value="Finalizada" selected="@(estado == "Finalizada")">Finalizada</option>
                    <option value="Cancelada" selected="@(estado == "Cancelada")">Cancelada</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Desde</label>
                <input type="date" name="desde" value="@desde" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Hasta</label>
                <input type="date" name="hasta" value="@hasta" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="fa-solid fa-filter me-1"></i> Filtrar</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Código</th>
                <th>Inmueble</th>
                <th>Inquilino</th>
                <th>Fechas</th>
                <th>Monto Total</th>
                <th>Pagado / Saldo</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">No se encontraron reservas con los filtros seleccionados.</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">#@item.Id</td>
                    <td>
                        <div class="fw-semibold">@item.InmuebleDireccion</div>
                        <small class="text-muted">Dueño: @item.PropietarioNombre</small>
                    </td>
                    <td>
                        <div>@item.InquilinoNombre</div>
                        <small class="text-muted">DNI: @item.InquilinoDni</small>
                    </td>
                    <td>
                        <span class="badge bg-light text-dark border">@item.FechaInicio.ToString("dd/MM/yyyy")</span> al 
                        <span class="badge bg-light text-dark border">@item.FechaFin.ToString("dd/MM/yyyy")</span>
                        <div class="small text-muted">@item.CantidadDias días</div>
                    </td>
                    <td>
                        <div class="fw-bold">@item.MonedaPrecio @item.MontoTotalEstimado.ToString("N2")</div>
                        <small class="text-muted">@item.MonedaPrecio @item.MontoPorDia.ToString("N2")/día</small>
                    </td>
                    <td>
                        <span class="text-success fw-semibold">@item.MonedaPrecio @item.TotalPagado.ToString("N2")</span>
                        @if (item.SaldoPendiente > 0)
                        {
                            <div class="small text-danger">Resta: @item.MonedaPrecio @item.SaldoPendiente.ToString("N2")</div>
                        }
                    </td>
                    <td>
                        @if (item.Estado == "Vigente")
                        {
                            <span class="badge bg-success">Vigente</span>
                        }
                        else if (item.Estado == "Finalizada")
                        {
                            <span class="badge bg-secondary">Finalizada</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">@item.Estado</span>
                        }
                    </td>
                    <td class="text-end">
                        <div class="btn-group" role="group">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id" title="Detalle">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                            <a class="btn btn-sm btn-outline-success" asp-controller="Pagos" asp-action="PorReserva" asp-route-reservaId="@item.Id" title="Ver / Cargar Pagos">
                                <i class="fa-solid fa-money-bill-wave"></i>
                            </a>
                            @if (item.Estado == "Vigente")
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id" title="Editar">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                            }
                            @if (User.IsInRole("Administrador"))
                            {
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id" title="Eliminar">
                                    <i class="fa-solid fa-trash-can"></i>
                                </a>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (totalPaginas > 1)
{
    <nav aria-label="Paginado de reservas">
        <ul class="pagination">
            <li class="page-item @(pagina <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@(pagina - 1)" asp-route-estado="@estado" asp-route-desde="@desde" asp-route-hasta="@hasta">Anterior</a>
            </li>
            @for (var i = 1; i <= totalPaginas; i++)
            {
                <li class="page-item @(i == pagina ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-estado="@estado" asp-route-desde="@desde" asp-route-hasta="@hasta">@i</a>
                </li>
            }
            <li class="page-item @(pagina >= totalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@(pagina + 1)" asp-route-estado="@estado" asp-route-desde="@desde" asp-route-hasta="@hasta">Siguiente</a>
            </li>
        </ul>
    </nav>
}
