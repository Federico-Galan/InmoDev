@model TipoInmueble

@{
    ViewData["Title"] = "Editar tipo de inmueble";
}

<h1 class="h3">Editar tipo de inmueble</h1>
<hr />

<form asp-action="Edit" asp-route-id="@Model.Id" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <partial name="_Form" model="Model" />
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a class="btn btn-secondary" asp-action="Index">Volver</a>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
