@model UsuarioFormViewModel
@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h1 class="h4 mb-0">Editar Usuario: @Model.Nombre</h1>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    @if (!string.IsNullOrWhiteSpace(Model.Avatar))
                    {
                        <div class="text-center mb-3">
                            <img src="@Model.Avatar" alt="Avatar" class="rounded-circle border shadow-sm" style="width: 80px; height: 80px; object-fit: cover;" />
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" type="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Rol" class="form-label"></label>
                            <select asp-for="Rol" class="form-select">
                                <option value="Empleado">Empleado</option>
                                <option value="Administrador">Administrador</option>
                            </select>
                            <span asp-validation-for="Rol" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Clave" class="form-label">Nueva Contraseña (Opcional)</label>
                            <input asp-for="Clave" type="password" class="form-control" placeholder="Dejar en blanco para mantener actual" />
                            <span asp-validation-for="Clave" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FotoAvatar" class="form-label">Cambiar Avatar</label>
                        <input asp-for="FotoAvatar" type="file" class="form-control" accept="image/png, image/jpeg, image/webp" />
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="Activo" class="form-check-input" />
                        <label asp-for="Activo" class="form-check-label"></label>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
                        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i> Actualizar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
