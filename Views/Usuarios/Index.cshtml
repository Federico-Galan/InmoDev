@model IEnumerable<Usuario>
@{
    ViewData["Title"] = "Gestión de Usuarios";
    var pagina = ViewBag.Pagina as int? ?? 1;
    var totalPaginas = ViewBag.TotalPaginas as int? ?? 1;
    var busqueda = ViewBag.Busqueda as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Usuarios del Sistema</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="fa-solid fa-user-plus me-1"></i> Nuevo Usuario</a>
</div>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-info">@ViewBag.Mensaje</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <input type="search" name="busqueda" value="@busqueda" class="form-control" placeholder="Buscar por nombre o email..." />
            <button class="btn btn-outline-secondary" type="submit"><i class="fa-solid fa-search"></i> Buscar</button>
            @if (!string.IsNullOrWhiteSpace(busqueda))
            {
                <a asp-action="Index" class="btn btn-outline-danger">Limpiar</a>
            }
        </div>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Avatar</th>
            <th>Nombre</th>
            <th>Email</th>
            <th>Rol</th>
            <th>Estado</th>
            <th>Fecha Alta</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrWhiteSpace(item.Avatar))
                    {
                        <img src="@item.Avatar" alt="Avatar" class="rounded-circle" style="width: 38px; height: 38px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px; font-size: 0.9rem;">
                            <i class="fa-solid fa-user"></i>
                        </div>
                    }
                </td>
                <td class="fw-semibold">@item.Nombre</td>
                <td>@item.Email</td>
                <td>
                    <span class="badge @(item.Rol == "Administrador" ? "bg-danger" : "bg-info text-dark")">@item.Rol</span>
                </td>
                <td>
                    <span class="badge @(item.Activo ? "bg-success" : "bg-secondary")">@(item.Activo ? "Activo" : "Inactivo")</span>
                </td>
                <td>@item.FechaCreacion.ToString("dd/MM/yyyy")</td>
                <td class="text-end">
                    <div class="btn-group" role="group">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id" title="Editar">
                            <i class="fa-solid fa-pen"></i>
                        </a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id" title="Eliminar">
                            <i class="fa-solid fa-trash-can"></i>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (totalPaginas > 1)
{
    <nav aria-label="Paginado de usuarios">
        <ul class="pagination">
            <li class="page-item @(pagina <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@(pagina - 1)" asp-route-busqueda="@busqueda">Anterior</a>
            </li>
            @for (var i = 1; i <= totalPaginas; i++)
            {
                <li class="page-item @(i == pagina ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-busqueda="@busqueda">@i</a>
                </li>
            }
            <li class="page-item @(pagina >= totalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@(pagina + 1)" asp-route-busqueda="@busqueda">Siguiente</a>
            </li>
        </ul>
    </nav>
}
