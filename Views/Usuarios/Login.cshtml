@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <i class="fa-solid fa-house-laptop fa-3x text-primary mb-2"></i>
                    <h2 class="h4 fw-bold">InmoDev</h2>
                    <p class="text-muted small">Gestión de Alquileres Temporarios</p>
                </div>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-envelope text-muted"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="nombre@inmodev.local" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Clave" class="form-label small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-lock text-muted"></i></span>
                            <input asp-for="Clave" class="form-control" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Clave" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="Recordarme" class="form-check-input" />
                        <label asp-for="Recordarme" class="form-check-label small"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        <i class="fa-solid fa-right-to-bracket me-1"></i> Ingresar
                    </button>
                </form>

                <div class="mt-4 p-2 bg-light rounded text-center small text-muted">
                    <div><strong>Admin:</strong> admin@inmodev.local / admin123</div>
                    <div><strong>Empleado:</strong> empleado@inmodev.local / empleado123</div>
                </div>
            </div>
        </div>
    </div>
</div>
