@model PerfilViewModel
@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h1 class="h4 mb-0"><i class="fa-solid fa-user-gear me-2 text-primary"></i>Mi Perfil</h1>
            </div>
            <div class="card-body p-4">
                @if (ViewBag.Mensaje != null)
                {
                    <div class="alert alert-success">@ViewBag.Mensaje</div>
                }

                <form asp-action="Perfil" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="text-center mb-4">
                        @if (!string.IsNullOrWhiteSpace(Model.AvatarActual))
                        {
                            <img src="@Model.AvatarActual" alt="Avatar" class="rounded-circle shadow-sm border" style="width: 110px; height: 110px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 110px; height: 110px; font-size: 2.5rem;">
                                <i class="fa-solid fa-user"></i>
                            </div>
                        }
                        <div class="mt-2">
                            <span class="badge @(Model.Rol == "Administrador" ? "bg-danger" : "bg-info text-dark")">@Model.Rol</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" readonly disabled />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="FotoAvatar" class="form-label fw-semibold"></label>
                        <input asp-for="FotoAvatar" type="file" class="form-control" accept="image/png, image/jpeg, image/webp" />
                        <div class="form-text">Formatos permitidos: JPG, PNG, WEBP (máx. 2MB).</div>
                        <span asp-validation-for="FotoAvatar" class="text-danger small"></span>
                    </div>

                    <hr />
                    <h5 class="h6 fw-bold mb-3 text-muted">CAMBIO DE CONTRASEÑA (Opcional)</h5>

                    <div class="mb-3">
                        <label asp-for="ClaveActual" class="form-label"></label>
                        <input asp-for="ClaveActual" class="form-control" placeholder="Requerida solo si desea cambiar la clave" />
                        <span asp-validation-for="ClaveActual" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="NuevaClave" class="form-label"></label>
                            <input asp-for="NuevaClave" class="form-control" placeholder="Mínimo 6 caracteres" />
                            <span asp-validation-for="NuevaClave" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmarClave" class="form-label"></label>
                            <input asp-for="ConfirmarClave" class="form-control" placeholder="Repita la nueva clave" />
                            <span asp-validation-for="ConfirmarClave" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Volver</a>
                        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i> Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
